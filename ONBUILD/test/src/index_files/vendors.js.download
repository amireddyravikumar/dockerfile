    IMPORT_MODULE_METADATA: "IMPORT_MODULE_METADATA",
    FETCH_PACKAGE_METADATA_RESULT: "FETCH_PACKAGE_METADATA_RESULT",
    IMPORT_MODULE_METADATA_RESULT: "IMPORT_MODULE_METADATA_RESULT",
    WORKER_READY: "WORKER_READY",
    WORKER_CRASH_DIAGNOSTIC: "WORKER_CRASH_DIAGNOSTIC",
    UNKNOWN_REQUEST: "UNKNOWN_REQUEST",
};
const emitCrashDiagnostic = (diagnostic) => {
    try {
        self.postMessage({
            type: WorkerMessageType.WORKER_CRASH_DIAGNOSTIC,
            diagnostic,
        });
    }
    catch {
    }
};
self.onunhandledrejection = (event) => {
    emitCrashDiagnostic({
        type: "unhandled_rejection",
        message: String(event.reason?.message || event.reason),
        stack: event.reason?.stack?.substring(0, 2000),
    });
};
self.addEventListener("error", (event) => {
    emitCrashDiagnostic({
        type: "uncaught_error",
        message: event.message,
        stack: event.error?.stack?.substring(0, 2000),
    });
});
const WorkerRequestStatus = {
    SUCCESS: "success",
    ERROR: "error",
};
const isFetchPackageMetadataRequest = (msg) => {
    return msg.type === WorkerMessageType.FETCH_PACKAGE_METADATA;
};
const isImportModuleMetadataRequest = (msg) => {
    return msg.type === WorkerMessageType.IMPORT_MODULE_METADATA;
};
const handleFetchRequest = async (id, payload) => {
    const { url, options, timeout } = payload;
    try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => {
            controller.abort();
        }, timeout);
        try {
            const fetchResponse = await fetch(url, {
                ...options,
                signal: controller.signal,
            });
            clearTimeout(timeoutId);
            const headers = {};
            fetchResponse.headers.forEach((value, key) => {
                headers[key] = value;
            });
            const responseText = await fetchResponse.text();
            const message = {
                type: WorkerMessageType.FETCH_PACKAGE_METADATA_RESULT,
                status: WorkerRequestStatus.SUCCESS,
                id,
                data: {
                    status: fetchResponse.status,
                    body: responseText,
                    headers,
                },
            };
            self.postMessage(message);
        }
        catch (error) {
            clearTimeout(timeoutId);
            const errorMessage = error instanceof Error
                ? error.name === "AbortError"
                    ? \`Timed out: \${error.message}\`
                    : \`Fetch error: \${error.message}\`
                : "Unknown fetch error";
            const message = {
                type: WorkerMessageType.FETCH_PACKAGE_METADATA_RESULT,
                status: WorkerRequestStatus.ERROR,
                id,
                error: errorMessage,
            };
            self.postMessage(message);
        }
    }
    catch (error) {
        const errorMessage = error instanceof Error ? error.message : "Unknown error";
        const message = {
            type: WorkerMessageType.FETCH_PACKAGE_METADATA_RESULT,
            status: WorkerRequestStatus.ERROR,
            id,
            error: errorMessage,
        };
        self.postMessage(message);
    }
};
const handleImportRequest = async (id, payload) => {
    const { url } = payload;
    try {
        const importedModule = await import(url);
        const moduleMetadata = importedModule.moduleMetadata;
        if (!moduleMetadata) {
            throw new Error("Module does not export moduleMetadata");
        }
        const message = {
            type: WorkerMessageType.IMPORT_MODULE_METADATA_RESULT,
            status: WorkerRequestStatus.SUCCESS,
            id,
            data: {
                moduleMetadata,
            },
        };
        self.postMessage(message);
    }
    catch (error) {
        const errorMessage = error instanceof Error ? \`Import error: \${error.message}\` : "Unknown import error";
        const message = {
            type: WorkerMessageType.IMPORT_MODULE_METADATA_RESULT,
            status: WorkerRequestStatus.ERROR,
            id,
            error: errorMessage,
        };
        self.postMessage(message);
    }
};
self.addEventListener("message", async (event) => {
    try {
        const request = event.data;
        if (isFetchPackageMetadataRequest(request)) {
            await handleFetchRequest(request.id, request.payload);
        }
        else if (isImportModuleMetadataRequest(request)) {
            await handleImportRequest(request.id, request.payload);
        }
        else {
            const unknownRequest = request;
            const requestPayload = JSON.stringify(unknownRequest).substring(0, 2000);
            console.warn("UCAF Web Worker received unknown message type:", requestPayload);
            const errorMessage = {
                type: WorkerMessageType.UNKNOWN_REQUEST,
                id: unknownRequest.id,
                error: \`Unsupported request type: \${unknownRequest.type}\`,
                receivedType: unknownRequest.type,
                unknownRequestPayload: requestPayload,
            };
            self.postMessage(errorMessage);
        }
    }
    catch (error) {
        emitCrashDiagnostic({
            type: "message_handler_error",
            message: error instanceof Error ? error.message : String(error),
            stack: error instanceof Error ? error.stack?.substring(0, 2000) : undefined,
        });
    }
});
const readyMessage = {
    type: WorkerMessageType.WORKER_READY,
};
self.postMessage(readyMessage);
export {};
