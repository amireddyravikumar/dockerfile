  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  word-break: break-all;
  hyphens: auto;
  overflow-y: auto;
  overflow-x: hidden;
  background-color: #ffffff;
  flex: none;
  order: 0;
  flex-grow: 1;
  position: relative;
}

.InfoBoxContainer {
  display: flex;
  background-color: #ffffff;
  width: 100%;
  overflow: auto;
}
.InfoBoxContainer .InfoBoxSpace {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  word-break: break-all;
  max-height: 145px;
  order: 0;
  flex-grow: 1;
}

.CopyButton {
  padding: 10px;
}

.InfoBoxContainer.background {
  background-color: #f2f3f3;
}

.ExpandShift {
  margin-top: -5.5px;
}

.access-denied-popover-container {
  display: flex;
}

.access-denied-popover-content {
  flex: 1;
}

body.awsui-polaris-dark-mode .InfoBoxSpace,
body.awsui-polaris-dark-mode .InfoBoxSpace.popover,
body.awsui-polaris-dark-mode .InfoBoxGrid {
  background-color: #1a2029; /* grey-800 https://polaris.a2z.com/foundation/visual-foundation/colors/ */
